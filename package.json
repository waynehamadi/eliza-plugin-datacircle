    "api-directory",
    "api-pricing",
    "b2b-data",
    "data-enrichment",
    "datacircle"
  ],
  "homepage": "https://datacircle.dev",
  "bugs": {
    "url": "https://github.com/waynehamadi/eliza-plugin-datacircle/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/waynehamadi/eliza-plugin-datacircle.git"
  },
  "license": "MIT",
  "author": "Datacircle <wayne@datacircle.dev> (https://datacircle.dev)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
